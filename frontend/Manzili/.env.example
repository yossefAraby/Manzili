# Copy to .env.local and fill in. Never commit .env.local (it's gitignored).
# Next.js loads .env.local; restart `npm run dev` after editing.

# .NET backend base URL (include the /api/v1 path)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080/api/v1

# Display / app URLs
NEXT_PUBLIC_CURRENCY_SYMBOL=EGP
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (publishable TEST key — card checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_CURRENCY=egp

# Google Sign-In (public OAuth client id → "Continue with Google" button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Kashier payment options (Mobile Wallet + Fawry). Set true once the backend has Manzili:Kashier:MerchantId.
NEXT_PUBLIC_KASHIER_ENABLED=false

# AI providers (server-side; used by app/api/ai/* route handlers). Leave blank to disable a provider.
BLUESMINDS_API_KEY=
ZAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
POLLINATIONS_API_KEY=
